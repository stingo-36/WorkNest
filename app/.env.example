DATABASE_URL="postgresql://workspace:workspace@localhost:5434/workspace?schema=public"
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_TRUST_HOST=true
# Demo account the seed creates (`npm run setup` fills both with local values).
SEED_EMAIL="demo@worknest.local"
# Password the seed scripts give the demo account (8+ chars). Never commit the real one.
SEED_PASSWORD="change-me-please"
# Hosted DB (Neon) DIRECT connection string — used by `npm run db:hosted`. Never commit the real one.
HOSTED_DATABASE_URL=""
# Optional: a server-wide OpenRouter key (https://openrouter.ai/keys) for AI work-log
# summaries and 5-15 reports. Each user can also add their own key in Profile → Account.
# No key anywhere → AI summaries and reports are simply off (nothing is made up).
OPENROUTER_API_KEY=""
# Comma-separated, tried in order. Empty → "google/gemma-4-31b-it:free, openrouter/free".
OPENROUTER_MODEL=""
# Optional backup: a server-wide Groq key (https://console.groq.com/keys), used when
# OpenRouter fails or has no key. Empty GROQ_MODEL → "openai/gpt-oss-120b, qwen/qwen3.8-27b, openai/gpt-oss-20b" (comma-separated, tried in turn).
GROQ_API_KEY=""
GROQ_MODEL=""

# Optional: the most tokens (prompt + reply) one AI request may use. Groq's free tier
# refuses requests over its per-minute limit, so its default is low. Bigger inputs are
# trimmed in the middle to fit (and the reply room shrinks) instead of failing.
GROQ_MAX_REQUEST_TOKENS=""
OPENROUTER_MAX_REQUEST_TOKENS=""

# Account that `npx tsx prisma/seed-fresh-demo.ts` resets (destructive for that account only).
DEMO_EMAIL=""

# Optional: Profile → Gmail import. A Google Cloud OAuth "Web application" client with
# the Gmail API enabled; authorised redirect URI: <site>/api/gmail/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
