DATABASE_URL="postgresql://workspace:workspace@localhost:5434/workspace?schema=public"
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_TRUST_HOST=true
# Demo account the seed creates (`npm run setup` fills both with local values).
SEED_EMAIL="demo@worknest.local"
# Password the seed scripts give the demo account (8+ chars). Never commit the real one.
SEED_PASSWORD="change-me-please"
# Hosted DB (Neon) DIRECT connection string — used by `npm run db:hosted`. Never commit the real one.
HOSTED_DATABASE_URL=""
# Optional: a server-wide OpenRouter key (https://openrouter.ai/keys) for AI work-log
# summaries and 5-15 reports. Each user can also add their own key in Profile → Account.
# No key anywhere → AI summaries and reports are simply off (nothing is made up).
OPENROUTER_API_KEY=""
# Comma-separated, tried in order. Empty → "google/gemma-4-31b-it:free, openrouter/free".
OPENROUTER_MODEL=""
